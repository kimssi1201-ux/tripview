---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaFrame from "../../components/MediaFrame.astro";
import PostSection from "../../components/PostSection.astro";
import ProductCard from "../../components/ProductCard.astro";
import TravelCard from "../../components/TravelCard.astro";
import { CATEGORY_PAGES, cardImageAsset, groupByCategoryData, selectAccommodationItems } from "../../lib/content.mjs";

const page = CATEGORY_PAGES.find((item) => item.path === "/travel/");
const data = groupByCategoryData();
const products = selectAccommodationItems({ posts: data.travelPosts, limit: 6 });
const bannerPost = data.travelPosts.find((post) => cardImageAsset(post)?.src);
const bannerAsset = bannerPost ? cardImageAsset(bannerPost) : null;
const ogImage = bannerAsset?.src || "";
---

<BaseLayout title={`${page.title} - 트립뷰`} description={page.description} canonicalPath="/travel/" activePath="/travel/" ogImage={ogImage}>
  <main class="site-page hub-page">
    <section class:list={["hub-banner", bannerAsset?.src && "has-image"]}>
      <div class="hub-banner-copy">
        <span class="kicker">CATEGORY</span>
        <h1>{page.title}</h1>
        <p>{page.description}</p>
        <span class="banner-count">{data.travelPosts.length.toLocaleString("ko-KR")}개 글</span>
        <div class="tag-row">
          <a href="#tag-overseas">9월 해외여행</a>
          <a href="#tag-fall">가을·단풍</a>
          <a href="#tag-weekend">이번 주말</a>
          <a href="#tag-water">물놀이·계곡</a>
          <a href="#tag-indoor">실내여행</a>
          <a href="#tag-family">아이와</a>
        </div>
      </div>
      {bannerAsset?.src && (
        <div class="hub-banner-image">
          <MediaFrame asset={bannerAsset} caption={false} ratio="16 / 9" />
        </div>
      )}
    </section>
    <PostSection id="tag-overseas" title="9월 해외여행" note="가까운 해외 도시와 휴양지를 계절 변수 중심으로 정리" posts={data.overseasPosts} />
    <PostSection id="tag-fall" title="가을·단풍" note="계절 키워드 글을 별도 묶음으로 노출" posts={data.fallPosts} />
    <PostSection id="tag-weekend" title="이번 주말" note="기존 이번 주말 카테고리를 태그로 전환" posts={data.travelPosts.filter((post) => post.editorialTopics?.includes("weekend"))} />
    <PostSection id="tag-water" title="물놀이·계곡" note="기존 물놀이 카테고리를 태그로 전환" posts={data.waterPosts} />
    <PostSection id="tag-indoor" title="실내여행" note="기존 실내여행 카테고리를 태그로 전환" posts={data.indoorPosts} />
    <PostSection id="tag-family" title="아이와" note="기존 아이와 카테고리를 태그로 전환" posts={data.familyPosts} />
    <section class="block" id="travel-stay" aria-labelledby="travel-stay-title">
      <div class="block-head">
        <div><span class="kicker">BOOKING</span><h2 id="travel-stay-title">여행지 주변 숙소</h2></div>
        <p class="block-note">제휴 링크 · 예약 전 조건 확인</p>
      </div>
      <div class="story-grid">
        {products.map((product) => <ProductCard product={product} type="accommodation" />)}
      </div>
    </section>
    <section class="block" id="all-posts" aria-labelledby="all-posts-title">
      <div class="block-head">
        <div><span class="kicker">ALL</span><h2 id="all-posts-title">여행지 글 목록</h2></div>
        <p class="block-note">최신 검수 글 기준</p>
      </div>
      <div class="story-list">
        {data.travelPosts.slice(0, 48).map((post) => <TravelCard post={post} showExcerpt={false} />)}
      </div>
    </section>
  </main>
</BaseLayout>
