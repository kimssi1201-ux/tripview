---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { AFFILIATE_DISPLAY_ENABLED } from "../../lib/monetization.mjs";
import { flightDeals, flightSlug, productPriceText } from "../../lib/content.mjs";
---

<BaseLayout title="항공권 여행 계획 안내 - 트립뷰" description="여행 날짜와 시차를 확인하고 항공권 가격을 비교할 때 꼭 살필 사항을 안내합니다." canonicalPath="/flight-deals/" activePath="/travel/" robots="noindex, follow" adsense={false}>
  <main class="site-page hub-page">
    <section class="hub-banner">
      <div class="hub-banner-copy">
        <span class="kicker">FLIGHT PLANNING</span>
        <h1>항공권 예약 전 확인할 점</h1>
        <p>현재 트립뷰에서는 제휴 항공권 상품 소개를 중지했습니다. 항공권을 예약하기 전에는 출발·도착 공항의 현지 시각, 수하물 포함 여부, 환승과 취소 조건을 먼저 확인하세요.</p>
        <p><a class="cta-link" href="/tools/calendar/">여행 날짜 정하기</a> <a class="cta-link" href="/tools/world-time/">현지 시차 확인</a></p>
      </div>
    </section>
    {AFFILIATE_DISPLAY_ENABLED && (
      <section class="block" aria-labelledby="flight-title">
        <div class="block-head">
          <div><span class="kicker">FLIGHT</span><h2 id="flight-title">항공권 목록</h2></div>
          <p class="block-note">{flightDeals.length.toLocaleString("ko-KR")}개</p>
        </div>
        <div class="flight-list">
          {flightDeals.map((deal) => (
            <a class="flight-card" href={`/flight-deals/${flightSlug(deal)}/`}>
              <strong>{deal.title}</strong>
              <span>{[deal.description, productPriceText(deal)].filter(Boolean).join(" · ")}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>
