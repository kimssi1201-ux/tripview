---
import ArticleLayout from "../layouts/ArticleLayout.astro";
import AffiliateInlineBlock from "../components/AffiliateInlineBlock.astro";
import MediaFrame from "../components/MediaFrame.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import TravelCard from "../components/TravelCard.astro";
import { articleAffiliatePlacements } from "../lib/affiliate.mjs";
import { readableSections, removeDuplicateLead } from "../lib/readability.mjs";
import { AFFILIATE_DISPLAY_ENABLED } from "../lib/monetization.mjs";
import {
  allPosts,
  articleActivePath,
  articleContentImageAssets,
  articleInlineAssets,
  compactRegion,
  EDITORIAL_AUTHOR_NAME,
  EDITORIAL_AUTHOR_PATH,
  faqPairs,
  formatKoreanDate,
  infoValue,
  isIndexablePost,
  isLodgingPost,
  officialLinks,
  postModifiedDate,
  postPublishedDate,
  postTitle,
  regionCardImageAsset,
  regionSlug,
  relatedPostsFor,
  sectionPairs,
} from "../lib/content.mjs";

export function getStaticPaths() {
  return allPosts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const sections = removeDuplicateLead(readableSections(sectionPairs(post)), post.excerpt || post.description || "");
const faqs = faqPairs(post);
const inlineAssets = articleInlineAssets(post).map((asset, index) => ({ asset, number: index + 1 }));
const inlinePlacements = new Map();
if (sections.length && inlineAssets.length) {
  inlineAssets.forEach((item, index) => {
    const lastSectionIndex = Math.max(0, sections.length - 1);
    const denominator = Math.max(1, inlineAssets.length - 1);
    const sectionIndex = Math.min(lastSectionIndex, Math.round((index / denominator) * lastSectionIndex));
    const items = inlinePlacements.get(sectionIndex) || [];
    items.push(item);
    inlinePlacements.set(sectionIndex, items);
  });
}
const leadSection = sections[0];
const remainingSections = sections.slice(1);
const indexable = isIndexablePost(post);
const activePath = articleActivePath(post);
const affiliatePlacements = indexable && AFFILIATE_DISPLAY_ENABLED ? articleAffiliatePlacements({ post, sections, maxBlocks: 2 }) : [];
const inlineAffiliate = affiliatePlacements.find((placement) => placement.placement === "inline");
const bottomAffiliate = affiliatePlacements.find((placement) => placement.placement === "bottom");
const inlineAffiliateAfterSectionIndex = inlineAffiliate?.afterSectionIndex ?? -1;
const regionRelated = relatedPostsFor(post, 8).filter((item) => compactRegion(item.region) === compactRegion(post.region));
const sourceLinks = officialLinks(post);
const lodgingGuideAssets = isLodgingPost(post) ? articleContentImageAssets(post, { excludeHero: true }).slice(0, 3) : [];
const placeName = post.sourceTitle || postTitle(post);
const address = infoValue(post, ["주소", "장소"]);
const parking = infoValue(post, "주차");
const hours = infoValue(post, ["운영 확인", "시간"]);
const fee = infoValue(post, "요금");
const destinationRegion = compactRegion(post.region);
const isOverseasTrip = destinationRegion === "해외";
const supportsMainlandRail = new Set(["서울","경기","인천","강원","대전","세종","충북","충남","광주","전북","전남","대구","부산","울산","경북","경남"]).has(destinationRegion);
const publishedDate = postPublishedDate(post);
const modifiedDate = postModifiedDate(post);
const publishedDateLabel = formatKoreanDate(publishedDate);
const modifiedDateLabel = formatKoreanDate(modifiedDate);
---

<ArticleLayout post={post}>
  {leadSection && (
    <>
      <section class="article-lead-section">
        <h2>{leadSection.heading}</h2>
        {leadSection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
      {(inlinePlacements.get(0) || []).map(({ asset, number }) => (
        <>
          <Fragment set:html={`<!-- ARTICLE_INLINE_PHOTO_START ${number} -->`} />
          <MediaFrame asset={asset} post={post} caption className="inline-figure article-inline-figure" ratio="16 / 10" />
          <Fragment set:html={"<!-- ARTICLE_INLINE_PHOTO_END -->"} />
        </>
      ))}
      {inlineAffiliateAfterSectionIndex === 0 && inlineAffiliate && (
        <AffiliateInlineBlock placement={inlineAffiliate} />
      )}
    </>
  )}

  {(address || hours || fee || parking) && (
    <section class="article-place-intro" aria-labelledby="article-place-intro-title">
      <h2 id="article-place-intro-title">방문 전 핵심 정보</h2>
      <p class="article-facts-lead">이 글에 기록된 ${placeName} 정보입니다. 바로 필요한 항목을 확인하고 출발 전에는 운영기관의 최신 안내와 비교하세요.</p>
      <dl class="article-facts-list">
        {address && <div><dt>위치·주소</dt><dd>{address}</dd></div>}
        {hours && <div><dt>운영 시간</dt><dd>{hours}</dd></div>}
        {fee && <div><dt>요금</dt><dd>{fee}</dd></div>}
        {parking && <div><dt>주차</dt><dd>{parking}</dd></div>}
      </dl>
      <p class="article-facts-note">글 최종 수정: <time datetime={modifiedDate}>{modifiedDateLabel}</time> · 수정일이 실시간 운영정보 재확인일을 뜻하지는 않습니다.</p>
      {sourceLinks.length > 0 && (
        <p class="article-facts-links">방문 전 관련 공식 안내 확인:
          {sourceLinks.slice(0, 2).map((source) => (
            <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>
          ))}
        </p>
      )}
    </section>
  )}

  {remainingSections.map((section, index) => {
    const sectionIndex = index + 1;
    return (
    <>
      <section>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>
      {(inlinePlacements.get(sectionIndex) || []).map(({ asset, number }) => (
        <>
          <Fragment set:html={`<!-- ARTICLE_INLINE_PHOTO_START ${number} -->`} />
          <MediaFrame asset={asset} post={post} caption className="inline-figure article-inline-figure" ratio="16 / 10" />
          <Fragment set:html={"<!-- ARTICLE_INLINE_PHOTO_END -->"} />
        </>
      ))}
      {inlineAffiliateAfterSectionIndex === sectionIndex && inlineAffiliate && (
        <AffiliateInlineBlock placement={inlineAffiliate} />
      )}
    </>
    );
  })}

  {lodgingGuideAssets.length > 0 && (
    <section class="lodging-photo-guide" aria-labelledby="lodging-photo-guide-title">
      <h2 id="lodging-photo-guide-title">숙소 사진으로 확인할 부분</h2>
      {lodgingGuideAssets.map((asset, index) => (
        <div class="lodging-photo-item">
          <p>
            {index === 0 && `${placeName} 사진에서는 숙소 외관과 주변 분위기를 먼저 확인할 수 있습니다. 예약 전에는 위치, 객실 조건, 취소 마감 시각을 함께 비교하세요.`}
            {index === 1 && `객실 사진은 실제 침대 구성과 창밖 방향, 욕실 상태를 보는 기준입니다. 동행 인원에 맞는 객실명과 포함 서비스를 예약 화면에서 다시 확인하세요.`}
            {index === 2 && `${compactRegion(post.region)} 일정에 넣을 때는 숙소 주변 이동 시간을 같이 잡는 편이 좋습니다. 체크인·아웃 시간과 주차 조건을 함께 확인하세요.`}
          </p>
          <MediaFrame asset={asset} post={post} caption ratio="16 / 10" />
        </div>
      ))}
    </section>
  )}

  {faqs.length > 0 && (
    <section aria-labelledby="faq-title">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {faqs.map((item) => (
        <details open>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>
  )}

  {bottomAffiliate && <AffiliateInlineBlock placement={bottomAffiliate} />}

  {indexable && (
    <section class="article-planning-links" aria-labelledby="article-planning-title">
      <h2 id="article-planning-title">이 여행을 계획하고 있다면</h2>
      <p>여행 날짜와 경비를 미리 정리하고, 이동 시간까지 확인하면 당일 일정을 더 여유롭게 준비할 수 있습니다.</p>
      <div class="article-planning-actions">
        <a href="/tools/calendar/">📅 여행 일정 달력</a>
        <a href="/tools/#budget">💳 여행 경비 계산</a>
        {isOverseasTrip ? (
          <a href="/tools/world-time/">🌍 현지 시차 확인</a>
        ) : supportsMainlandRail ? (
          <a href="https://mustview.co.kr/train" target="_blank" rel="noopener noreferrer">🚆 기차 시간표 · 레일맵 ↗</a>
        ) : (
          <a href="/tools/#packing">✓ 여행 준비물 확인</a>
        )}
      </div>
    </section>
  )}

  <RelatedPosts post={post} />

  {regionRelated.length > 0 && (
    <>
      <Fragment set:html={"<!-- REGION_RELATED_START -->"} />
      <section class="region-related" aria-labelledby="region-related-title">
        <h2 id="region-related-title">{compactRegion(post.region)}에서 함께 볼 글</h2>
        <div class="region-related-grid">
          {regionRelated.slice(0, 8).map((item) => <TravelCard post={item} showExcerpt={false} compact />)}
        </div>
        <p><a class="cta-link" href={`/region/${regionSlug(post.region)}/`}>{compactRegion(post.region)} 여행 허브 보기</a></p>
      </section>
      <Fragment set:html={"<!-- REGION_RELATED_END -->"} />
    </>
  )}

  {sourceLinks.length > 0 && (
    <section class="article-source-block" aria-labelledby="source-title">
      <h2 id="source-title">공식 확인처</h2>
      <p class="source-note">글 최종 수정일은 {modifiedDateLabel}입니다. 링크는 관련 원문을 직접 확인하기 위한 참고 경로이며, 모든 정보가 수정일에 재확인됐다는 뜻은 아닙니다.</p>
      {sourceLinks.map((source) => <p class="source-note"><a href={source.url} target="_blank" rel="noopener">{source.label}</a></p>)}
    </section>
  )}

  <section class="article-trust-block" aria-labelledby="trust-title">
    <h2 id="trust-title">작성·검수 정보</h2>
    <ul class="trust-list">
      <li>작성자: <a href={EDITORIAL_AUTHOR_PATH} rel="author">{EDITORIAL_AUTHOR_NAME}</a></li>
      <li>게시일: <time datetime={publishedDate}>{publishedDateLabel}</time></li>
      <li>수정일: <time datetime={modifiedDate}>{modifiedDateLabel}</time></li>
    </ul>
    <p class="trust-note">운영 시간, 요금, 휴무, 예약 조건은 현장 사정에 따라 바뀔 수 있습니다. 출발 전 공식 안내와 예약 화면을 한 번 더 확인하세요.</p>
  </section>
</ArticleLayout>

<style is:global>
  .article-facts-lead { margin: 8px 0 14px; }
  .article-facts-list { display: grid; gap: 0; padding: 0 14px; margin: 14px 0; border: 1px solid #dce9e8; border-radius: 10px; background: #f7fbfa; }
  .article-facts-list > div { display: grid; grid-template-columns: 105px minmax(0,1fr); gap: 10px; padding: 11px 0; border-bottom: 1px solid #e1edeb; }
  .article-facts-list > div:last-child { border-bottom: 0; }
  .article-facts-list dt { font-weight: 750; color: #375b5c; }
  .article-facts-list dd { margin: 0; color: #263a3a; overflow-wrap: anywhere; }
  .article-facts-note { font-size: 13px; color: #596f73; line-height: 1.65; }
  .article-facts-links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 14px; }
  .article-facts-links a { color: #05666a; text-decoration: underline; text-underline-offset: 3px; }
  @media(max-width: 600px) { .article-facts-list > div { grid-template-columns: 84px minmax(0,1fr); font-size: 14px; } }
  .article-planning-links { margin: 35px 0; padding: 22px; border: 1px solid #d8e7e8; border-radius: 14px; background: #f6faf9; }
  .article-planning-links h2 { margin: 0 0 9px; font-size: 21px; }
  .article-planning-links p { margin: 8px 0 15px; line-height: 1.7; color: #557078; }
  .article-planning-actions { display: flex; flex-wrap: wrap; gap: 9px; }
  .article-planning-actions a { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 14px; border-radius: 8px; background: white; border: 1px solid #cfdfdf; font-weight: 750; color: #086b72; text-decoration: none; font-size: 14px; }
  .article-planning-actions a:hover { background: #e5f5f2; border-color: #72b0aa; }
  @media (max-width: 650px) { .article-planning-links { padding: 15px; } .article-planning-actions a { flex: 1 1 100%; justify-content: center; } }
</style>
