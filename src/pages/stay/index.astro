---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MediaFrame from "../../components/MediaFrame.astro";
import ProductCard from "../../components/ProductCard.astro";
import TravelCard from "../../components/TravelCard.astro";
import { AFFILIATE_DISPLAY_ENABLED } from "../../lib/monetization.mjs";
import { CATEGORY_PAGES, accommodationProducts, cardImageAsset, groupByCategoryData, productImage } from "../../lib/content.mjs";

const page = CATEGORY_PAGES.find((item) => item.path === "/stay/");
const lodgingPosts = groupByCategoryData().travelPosts.filter((post) => /숙소|호텔|펜션|리조트/.test(`${post.category || ""} ${post.title || ""}`));
const editorialImage = lodgingPosts.map(cardImageAsset).find((asset) => asset?.src);
const bannerImage = editorialImage?.src || (AFFILIATE_DISPLAY_ENABLED ? productImage(accommodationProducts[0]) : "");
const bannerAsset = bannerImage ? {
  src: bannerImage,
  alt: editorialImage?.alt || `${accommodationProducts[0]?.title || "숙소"} 이미지`,
  width: 720,
  height: 480,
} : null;
---

<BaseLayout title={`${page.title} - 트립뷰`} description={page.description} canonicalPath="/stay/" activePath="/stay/" ogImage={bannerAsset?.src}>
  <main class="site-page hub-page">
    <section class:list={["hub-banner", bannerAsset?.src && "has-image"]}>
      <div class="hub-banner-copy">
        <span class="kicker">TRAVEL GUIDE</span>
        <h1>가격보다 위치와 취소 조건을 먼저 비교하세요</h1>
        <p>{page.description}</p>
        <span class="banner-count">{lodgingPosts.length.toLocaleString("ko-KR")}개 숙소 여행글</span>
      </div>
      {bannerAsset?.src && (
        <div class="hub-banner-image">
          <MediaFrame asset={bannerAsset} caption={false} ratio="16 / 9" />
        </div>
      )}
    </section>
    <section class="block" id="stay-checklist" aria-labelledby="stay-checklist-title">
      <div class="block-head">
        <div><span class="kicker">GUIDE</span><h2 id="stay-checklist-title">숙소 예약 전 확인할 다섯 가지</h2></div>
        <p class="block-note">예약 여부와 관계없이 체크하세요</p>
      </div>
      <ol class="booking-checklist">
        <li><strong>날짜와 인원:</strong> 같은 숙소라도 체크인 날짜, 숙박 인원, 객실 종류에 따라 최종 가격이 달라집니다.</li>
        <li><strong>실제 이동 시간:</strong> 관광지와 지도상 거리가 가까워도 대중교통 환승이나 주차 동선 때문에 이동 시간이 길어질 수 있습니다.</li>
        <li><strong>취소·변경:</strong> 무료 취소 가능 여부뿐 아니라 취소 마감 시각과 날짜 변경 수수료를 함께 살펴보세요.</li>
        <li><strong>최종 결제액:</strong> 세금, 추가 인원, 조식, 주차 등 별도 금액이 있는지 결제 직전 화면에서 확인하세요.</li>
        <li><strong>객실 포함 사항:</strong> 객실 사진과 실제 예약 객실명, 침대 구성, 조식·주차 포함 여부가 같은지 비교하세요.</li>
      </ol>
      <p class="block-note">요금과 객실 재고는 예약 일자에 따라 달라지므로 이용하려는 숙소에서 직접 확인하세요.</p>
    </section>
    {lodgingPosts.length > 0 && (
      <section class="block" id="lodging-posts" aria-labelledby="lodging-posts-title">
        <div class="block-head">
          <div><span class="kicker">GUIDE</span><h2 id="lodging-posts-title">숙소 관련 글</h2></div>
          <p class="block-note">검수 글 기준</p>
        </div>
        <div class="story-list">
          {lodgingPosts.slice(0, 24).map((post) => <TravelCard post={post} showExcerpt={false} />)}
        </div>
      </section>
    )}
    {AFFILIATE_DISPLAY_ENABLED && <section class="block" id="popular-stay" aria-labelledby="popular-stay-title">
      <div class="block-head">
        <div><span class="kicker">MYREALTRIP</span><h2 id="popular-stay-title">예약 상품 비교</h2></div>
        <p class="block-note">성인 2명 기준 · 예약 전 확인</p>
      </div>
      <div class="story-grid">
        {accommodationProducts.slice(0, 8).map((product) => <ProductCard product={product} type="accommodation" />)}
      </div>
    </section>}
  </main>
</BaseLayout>
