---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategorySection from "../components/CategorySection.astro";
import LeadStoryGrid from "../components/LeadStoryGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  articleCategoryLabel,
  cardImageAsset,
  compactRegion,
  homepageSections,
  imageAlt,
  postDate,
  postTitle,
} from "../lib/content.mjs";

const data = homepageSections();
const lead = data.topLeadPosts[0] || data.heroPosts[0];
const ogImage = lead ? cardImageAsset(lead)?.src : "";
const topStorySlugs = new Set([...data.topLeadPosts, ...data.topSmallPosts].map((post) => post.slug));
const latestSidebarPosts = (data.latestSidebarPosts || data.latestPosts || [])
  .filter((post) => post?.slug && !topStorySlugs.has(post.slug))
  .slice(0, 9);
const latestMeta = (post) => [articleCategoryLabel(post), compactRegion(post.region), postDate(post)].filter(Boolean).join(" · ");
---

<BaseLayout title="Tripview - 여행 뉴스 피드" description="Tripview는 국내외 여행지와 축제 소식, 숙소 정보, 체험 가이드, 여행 일정 도구를 한곳에서 볼 수 있는 여행 정보 서비스입니다." canonicalPath="/" activePath="/" ogImage={ogImage}>
  <main class="site-page home-magazine-page home-news-page">
    <section class="home-tools-quickbar" aria-labelledby="home-tools-quickbar-title">
      <div class="home-tools-quickbar-head">
        <div>
          <span class="kicker">TRIPVIEW TRAVEL PLANNER</span>
          <h2 id="home-tools-quickbar-title">여행 준비 바로가기</h2>
        </div>
        <a class="home-tools-quickbar-more" href="/tools/">여행 도구 전체 →</a>
      </div>
      <nav class="home-tools-quickbar-grid" aria-label="여행 계획 바로가기">
        <a class="home-tools-quicklink" href="/tools/calendar/"><span class="quicklink-icon" aria-hidden="true">📅</span><span class="quicklink-label">여행 달력</span><small>D-Day·일정</small></a>
        <a class="home-tools-quicklink" href="/tools/world-time/"><span class="quicklink-icon" aria-hidden="true">🌍</span><span class="quicklink-label">세계시간</span><small>나라별 시차</small></a>
        <a class="home-tools-quicklink" href="/tools/#budget"><span class="quicklink-icon" aria-hidden="true">💳</span><span class="quicklink-label">여행 예산</span><small>경비 계산</small></a>
        <a class="home-tools-quicklink" href="/tools/#packing"><span class="quicklink-icon" aria-hidden="true">🧳</span><span class="quicklink-label">준비물</span><small>체크리스트</small></a>
        <a class="home-tools-quicklink" href="https://mustview.co.kr/train" target="_blank" rel="noopener noreferrer"><span class="quicklink-icon" aria-hidden="true">🚆</span><span class="quicklink-label">레일맵</span><small>기차역 찾기 ↗</small></a>
      </nav>
    </section>
    <div class="home-news-layout">
      <div class="home-news-top-main">
        <LeadStoryGrid leadPosts={data.topLeadPosts} smallPosts={data.topSmallPosts} />
      </div>
      {latestSidebarPosts.length > 0 && (
        <aside class="home-news-aside" aria-label="최신 콘텐츠">
          <section class="latest-content-box home-latest-content" aria-labelledby="home-latest-content-title">
            <h2 id="home-latest-content-title">최신 콘텐츠</h2>
            <div class="latest-content-list">
              {latestSidebarPosts.map((post) => {
                const asset = cardImageAsset(post) || { src: "/assets/tripview-thumbnail-fallback.svg", width: 960, height: 540, alt: "트립뷰 여행정보 기본 이미지" };
                return (
                  <a class="latest-content-item" href={`/${post.slug}/`}>
                    <span class="latest-content-thumb">
                      {asset?.src && (
                        <img
                          src={asset.src}
                          alt={imageAlt(asset, post)}
                          width={asset.width || 120}
                          height={asset.height || 84}
                          loading="lazy"
                          decoding="async"
                          data-tripview-fallback="/assets/tripview-thumbnail-fallback.svg"
                        />
                      )}
                    </span>
                    <span class="latest-content-copy">
                      <strong>{postTitle(post)}</strong>
                      <span>{latestMeta(post)}</span>
                    </span>
                  </a>
                );
              })}
            </div>
          </section>
        </aside>
      )}
      <div class="home-news-sections">
        {data.magazineSections.map((section) => <CategorySection section={section} />)}

        <section class="home-region-strip" id="regions" aria-labelledby="regions-title">
          <SectionHeading title="지역별 여행" href="/region/" id="regions-title" />
          <div class="home-region-links">
            {data.regionGroups.map((group) => (
              <a class="home-region-link" href={`/region/${group.slug}/`}>
                <span>{group.label}</span>
                <small>{group.posts.length.toLocaleString("ko-KR")}개 글</small>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
