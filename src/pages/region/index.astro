---
import MediaFrame from "../../components/MediaFrame.astro";
import RegionLayout from "../../layouts/RegionLayout.astro";
import { regionCardImageAsset, regionGroups } from "../../lib/content.mjs";

const groups = regionGroups();
---

<RegionLayout title="지역별 여행 허브" description="지역별 트립뷰 허브 목록입니다. 각 허브에서 지역 소개, 글 목록, 숙소, 하위 시군구 그룹을 확인할 수 있습니다." tags={[
  { label: "여행지", href: "/travel/" },
  { label: "축제·행사", href: "/festival/" },
  { label: "숙소", href: "/stay/" },
  { label: "입장권·투어", href: "/ticket/" },
]}>
  <section class="block" id="region-list" aria-labelledby="region-list-title">
    <div class="block-head">
      <div><span class="kicker">HUBS</span><h2 id="region-list-title">지역 허브 목록</h2></div>
      <p class="block-note">검수 글이 있는 지역만 표시</p>
    </div>
    <div class="story-grid">
      {groups.map((group) => {
        const lead = group.posts.find((post) => regionCardImageAsset(post)?.src) || group.posts[0];
        const asset = regionCardImageAsset(lead);
        return (
          <a class="story-card" href={`/region/${group.slug}/`}>
            {asset?.src && <MediaFrame asset={asset} post={lead} caption={false} />}
            <span class="story-card-body">
              <span class="story-label">지역 허브</span>
              <strong>{group.label} 여행 허브</strong>
              <p>{group.label} 지역 글 목록과 숙소, 하위 시군구 그룹을 확인합니다.</p>
              <span class="story-meta">{group.posts.length.toLocaleString("ko-KR")}개 글</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>
</RegionLayout>
