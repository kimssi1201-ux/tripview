---
import MediaFrame from "./MediaFrame.astro";
import { articleCategoryLabel, cardImageAsset, compactRegion, festivalStatus, postDate, postExcerpt, postTitle } from "../lib/content.mjs";

const { post, className = "", compact = false, showExcerpt = true } = Astro.props;
const asset = cardImageAsset(post) || { src: "/assets/tripview-thumbnail-fallback.svg", alt: "사진 미제공 · 트립뷰 여행정보", width: 960, height: 540 };
const status = festivalStatus(post);
const label = [articleCategoryLabel(post), compactRegion(post.region), status.ended ? "행사 종료" : status.ongoing ? "진행 중" : status.upcoming ? "개최 예정" : ""].filter(Boolean).join(" · ");
---

<a class:list={["story-card", compact && "is-compact", className]} href={`/${post.slug}/`}>
  {asset?.src && <MediaFrame asset={asset} post={post} caption={false} />}
  <span class="story-card-body">
    <span class="story-label">{label}</span>
    <strong>{postTitle(post)}</strong>
    {showExcerpt && <p>{postExcerpt(post)}</p>}
    <span class="story-meta">{postDate(post)}</span>
  </span>
</a>
