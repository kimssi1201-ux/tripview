---
const { activePath = "/" } = Astro.props;

const navLinks = [
  { href: "/", label: "홈", key: "home" },
  { href: "/travel/", label: "여행뉴스", key: "travel" },
  { href: "/#domestic", label: "국내여행", key: "domestic" },
  { href: "/region/overseas/", label: "해외여행", key: "overseas" },
  { href: "/stay/", label: "숙소·예약", key: "stay" },
  { href: "/festival/", label: "축제·행사", key: "festival" },
  { href: "/ticket/", label: "입장권·투어", key: "ticket" },
];

function activeKey(path = "/") {
  if (path === "/") return "home";
  if (path.startsWith("/ticket") || path.startsWith("/data-ticket")) return "ticket";
  if (path.startsWith("/festival") || path.includes("festival-")) return "festival";
  if (path.startsWith("/stay") || path.startsWith("/data-stay")) return "stay";
  if (path.startsWith("/region/overseas")) return "overseas";
  if (
    path.includes("travel-osaka") ||
    path.includes("travel-taipei") ||
    path.includes("travel-danang") ||
    path.includes("travel-bangkok") ||
    path.includes("travel-september-overseas")
  ) return "overseas";
  if (path.startsWith("/travel") || path.startsWith("/region") || path.includes("travel-")) return "travel";
  return "";
}

const active = activeKey(activePath);
---

<header class="site-header" data-site-header>
  <div class="site-header-inner">
    <a class="site-brand" href="/">Tripview</a>
    <nav class="site-nav site-nav-desktop" aria-label="주요 메뉴">
      <div class="site-nav-main">
        {navLinks.map((item) => (
          <a class:list={["site-nav-link", active === item.key && "is-active"]} aria-current={active === item.key ? "page" : undefined} href={item.href}>{item.label}</a>
        ))}
      </div>
    </nav>
    <details class="site-search" data-site-search>
      <summary class="site-search-link" aria-label="검색">⌕</summary>
      <div class="site-search-panel">
        <input type="search" class="site-search-input" data-site-search-input placeholder="여행지·축제·지역 검색" autocomplete="off" aria-label="검색어 입력" />
        <div class="site-search-results" data-site-search-results>
          <p class="site-search-hint">여행지, 축제, 지역 이름으로 검색해보세요.</p>
        </div>
      </div>
    </details>
    <details class="site-mobile-menu" data-site-mobile-menu>
      <summary class="site-mobile-menu-button" aria-label="메뉴">☰</summary>
      <div class="mobile-menu-panel">
        <nav class="mobile-menu-links" aria-label="모바일 메뉴">
          {navLinks.map((item) => (
            <a class:list={["mobile-menu-link", active === item.key && "is-active"]} aria-current={active === item.key ? "page" : undefined} href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>
    </details>
  </div>
</header>
