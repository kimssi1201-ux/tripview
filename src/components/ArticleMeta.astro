---
import {
  EDITORIAL_AUTHOR_NAME,
  EDITORIAL_AUTHOR_PATH,
  articleCategoryLabel,
  compactRegion,
  formatKoreanDate,
  postModifiedDate,
  postPublishedDate,
} from "../lib/content.mjs";

const { post } = Astro.props;
const publishedDate = postPublishedDate(post);
const modifiedDate = postModifiedDate(post);
const parts = [
  articleCategoryLabel(post),
  compactRegion(post.region),
  post.read || "",
].filter(Boolean);
---

<div class="article-meta">
  <span class="article-meta-author">작성자 <a href={EDITORIAL_AUTHOR_PATH} rel="author">{EDITORIAL_AUTHOR_NAME}</a></span>
  <span class="article-meta-date">입력 <time datetime={publishedDate}>{formatKoreanDate(publishedDate)}</time></span>
  <span class="article-meta-date article-meta-modified">수정 <time datetime={modifiedDate}>{formatKoreanDate(modifiedDate)}</time></span>
  {parts.map((part) => <span class="article-meta-taxonomy">{part}</span>)}
</div>
